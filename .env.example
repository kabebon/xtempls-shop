# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
WEBAPP_URL=https://xtempls.ru
BACKEND_URL=http://backend:8000

# ===== Manager Notifications =====
# Получи свой chat_id написав @userinfobot
MANAGER_CHAT_ID=123456789

# ===== Internal Bot↔Backend Security =====
BOT_SECRET=change_me_random_secret_string

# ===== ЮKassa =====
# Реальные значения только в .env на сервере, сюда не коммитить.
# shopId и секретный ключ: кабинет ЮKassa → Интеграция → Ключи API.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ. false — платежи идут без чека, пока не заполните НДС ниже.
YOOKASSA_RECEIPTS=false
# НДС в чеке: 1 без НДС, 2 = 0%, 3 = 10%, 4 = 20%, 7 = 5%, 8 = 7%, 11 = 22%, 12 = 22/122.
YOOKASSA_VAT_CODE=1
# Система налогообложения, необязательно: 1 ОСН, 2 УСН доходы, 3 УСН доходы−расходы, 6 патент.
# Пустое значение не отправляется в ЮKassa.
YOOKASSA_TAX_SYSTEM_CODE=
# full_prepayment — оплата до отгрузки. Предмет расчёта: commodity (товар).
YOOKASSA_PAYMENT_MODE=full_prepayment
YOOKASSA_PAYMENT_SUBJECT=commodity
# Часовой пояс чека: 2 = Москва (UTC+3).
YOOKASSA_RECEIPT_TIMEZONE=2
# HTTP-уведомления настраиваются в кабинете, не в env:
#   URL: https://xtempls.ru/api/payments/notify   (это WEBAPP_URL + /api/payments/notify)
#   События: payment.succeeded и payment.canceled

# ===== Database =====
POSTGRES_USER=xtempls
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=xtempls_db
DATABASE_URL=postgresql+asyncpg://xtempls:change_me_strong_password@postgres:5432/xtempls_db

# ===== Auth (JWT) =====
SECRET_KEY=change_me_to_a_very_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Личный кабинет пользователей (JWT) =====
# Время жизни токена пользователя (в минутах). 43200 = 30 дней.
USER_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ===== Email (SMTP) =====
# Пустой SMTP_HOST = режим заглушки: письма пишутся в лог/файл backend/mail_log/
# (видно ссылку подтверждения локально). Заполни — отправка пойдёт по-настоящему.
# Рекомендация: Yandex 360 (бесплатно, привязка к домену) или Brevo (300 писем/день).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=XTEMPLS <noreply@xtempls.ru>
SMTP_USE_TLS=true

# ===== First Admin Account =====
ADMIN_DEFAULT_LOGIN=admin
ADMIN_DEFAULT_PASSWORD=change_me_strong_admin_password

# ===== Environment =====
ENVIRONMENT=production

# CORS origins (comma-separated). MUST be set to your real domain.
ALLOWED_ORIGINS=https://xtempls.ru

# Public contacts (shown in the storefront footer / "ask manager" links).
# All optional; links simply degrade if left empty.
MANAGER_USERNAME=xtempls_manager
CONTACT_TELEGRAM=xtempls_wear
